#   lankalistings-portal         -> management-portal/
#   lankalistings-mobile         -> mobile/
#   lankalistings-media-service  -> media-service/
#   lankalistings-identity-service -> identity-service/
#   lankalistings-gateway-service  -> gateway-service/
frontend-web/
management-portal/
mobile/
media-service/
identity-service/
gateway-service/

# Local tooling and installers (7-Zip, Tesseract installer, scratch images)
.tools/

node_modules/
package-lock.json
*.bundle
.env
.env.*
!.env.example
*.log
.DS_Store

# Root workspace glue - the apps now live in their own repositories
package.json

# Crash artifacts
*.stackdump

